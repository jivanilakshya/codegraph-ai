POSTGRES_DB=codegraph_ai
DATABASE_URL=postgresql://postgres:password@localhost:5432/codegraph_ai
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
UPLOAD_PATH=../uploads
REPOSITORY_PATH=../repositories
SYNC_NEO4J_GRAPH=false
# Set only when Git is not on PATH, for example:
# GIT_PYTHON_GIT_EXECUTABLE=C:/Program Files/Git/cmd/git.exe

# Step 2: Embedding configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Step 3: Vector Store (Qdrant) configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=code_chunks
